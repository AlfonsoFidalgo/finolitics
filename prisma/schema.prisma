// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// https://dbdiagram.io/d/finoliers-681790d11ca52373f56487b3

model Finoliers {
  id           String   @id
  displayName  String
  avatar       String
  about        String
  location     String
  numFollowers Int
  numFollowing Int
  numPosts     Int
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  votes        Votes[]
  tags         Tags[]
}

model Votes {
  id         String    @id @default(cuid())
  finolier   Finoliers @relation(fields: [finolierId], references: [id])
  finolierId String
  createdAt  DateTime  @default(now())
  vote       Boolean   @default(false)
  user       Users     @relation(fields: [userId], references: [id])
  userId     String
}

model Users {
  id    String  @id @default(cuid())
  votes Votes[]
  tags  Tags[]
}

model Tags {
  id         String    @id @default(cuid())
  name       String
  finolier   Finoliers @relation(fields: [finolierId], references: [id])
  user       Users     @relation(fields: [userId], references: [id])
  finolierId String
  userId     String
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  @@index([finolierId])
  @@index([userId])
}
